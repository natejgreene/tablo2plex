# Tablo2Plex Configuration

# Device Name
NAME=Tablo 4th Gen Proxy

# Device ID (for multiple devices on network)
DEVICE_ID=12345678

# Port to run the server on
PORT=8181

# IP Address (optional, auto-detected if not set)
# IP_ADDRESS=192.168.1.100

# Lineup update interval in days
LINEUP_UPDATE_INTERVAL=30

# Guide update interval in hours
GUIDE_UPDATE_INTERVAL=24

# Create XML guide from Tablo data (true/false)
CREATE_XML=false

# Include PseudoTV guide data (true/false)
INCLUDE_PSEUDOTV_GUIDE=false

# Number of days for guide data (1-7)
GUIDE_DAYS=2

# Logging
LOG_LEVEL=error
SAVE_LOG=false

# Tablo Device (if you have multiple devices)
# TABLO_DEVICE=your-device-id

# Auto-login credentials (optional, for automation)
# USER_NAME=your-email@example.com
# USER_PASS=your-password

# Custom Channels
# Add custom M3U8 streams as additional channels
# Format: JSON array with name, number, and url
# Example:
# CUSTOM_CHANNELS=[{"name":"MN Traffic Cam","number":"900.1","url":"https://video.dot.state.mn.us/public/C1495.stream/playlist.m3u8"},{"name":"Another Stream","number":"900.2","url":"https://example.com/stream.m3u8"}]
CUSTOM_CHANNELS=[]
